<?xml version="1.0" encoding="utf-8"?>
<!-- The 2x2 Usage widget: what is left to spend, and today's spend. Only views a widget may inflate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        style="@style/WidgetText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Usage"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:fontVariationSettings="'wght' 600, 'opsz' 14" />

    <TextView
        style="@style/WidgetText"
        android:id="@+id/or_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="26sp"
        android:fontVariationSettings="'wght' 600, 'opsz' 28"
        android:letterSpacing="-0.02" />

    <TextView
        style="@style/WidgetText"
        android:id="@+id/or_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:fontVariationSettings="'wght' 400, 'opsz' 14" />

    <TextView
        style="@style/WidgetText"
        android:id="@+id/or_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="13sp"
        android:fontVariationSettings="'wght' 600, 'opsz' 14" />

    <TextView
        style="@style/WidgetText"
        android:id="@+id/or_extra"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:fontVariationSettings="'wght' 400, 'opsz' 14" />

    <TextView
        style="@style/WidgetText"
        android:id="@+id/or_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:fontVariationSettings="'wght' 400, 'opsz' 14" />
</LinearLayout>
