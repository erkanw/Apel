<?xml version="1.0" encoding="utf-8"?>
<!-- The tall widget (three rows or more): the wide one's top, then rows for the agent's activity (Phase 7), then the bar or the
     request buttons at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/source"
            style="@style/WidgetText.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/time"
            style="@style/WidgetText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_faint" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/slot"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="-6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label"
                style="@style/WidgetText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/snippet"
                style="@style/WidgetText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="3" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/s1"
        style="@style/WidgetText"
        android:minHeight="44dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/s2"
        style="@style/WidgetText"
        android:minHeight="44dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/s3"
        style="@style/WidgetText"
        android:minHeight="44dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- A spacer that pushes the bar to the bottom. (A widget may only inflate the views Android lists for it: a plain View is not one.) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/deny"
            style="@style/WidgetText.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_btn_deny"
            android:text="Deny"
            android:textColor="@color/widget_danger" />

        <TextView
            android:id="@+id/allow"
            style="@style/WidgetText.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_allow"
            android:text="Allow"
            android:textColor="@color/widget_ground" />
    </LinearLayout>

    <TextView
        android:id="@+id/bar"
        style="@style/WidgetText.Bar"
        android:layout_width="match_parent"
        android:layout_height="40dp" />
</LinearLayout>
