<?xml version="1.0" encoding="utf-8"?>
<!-- The 2x2 widget: Blob over a label and a muted line (the source and when, or today's date). The slot takes Blob's loop (see BlobWidgetUpdater). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/slot"
        android:layout_width="84dp"
        android:layout_height="84dp" />

    <TextView
        android:id="@+id/label"
        style="@style/WidgetText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/meta"
        style="@style/WidgetText.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />
</LinearLayout>
