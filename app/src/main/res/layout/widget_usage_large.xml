                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="11sp"
                    android:fontVariationSettings="'wght' 400, 'opsz' 14" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/q3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/WidgetText"
                    android:id="@+id/q3n"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="11sp"
                    android:fontVariationSettings="'wght' 400, 'opsz' 14" />

                <TextView
                    style="@style/WidgetText"
                    android:id="@+id/q3v"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="11sp"
                    android:fontVariationSettings="'wght' 400, 'opsz' 14" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/q4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/WidgetText"
                    android:id="@+id/q4n"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="11sp"
                    android:fontVariationSettings="'wght' 400, 'opsz' 14" />

                <TextView
                    style="@style/WidgetText"
                    android:id="@+id/q4v"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="11sp"
                    android:fontVariationSettings="'wght' 400, 'opsz' 14" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
        android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Tokens"
                android:textColor="@color/widget_muted"
                android:textSize="12sp"
                android:fontVariationSettings="'wght' 400, 'opsz' 14" />

            <TextView
                style="@style/WidgetText"
                android:id="@+id/w_tok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="20sp"
                android:fontVariationSettings="'wght' 600, 'opsz' 28"
                android:letterSpacing="-0.02" />

            <LinearLayout
                android:id="@+id/t1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/WidgetText"
                    android:id="@+id/t1n"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="11sp"
                    android:fontVariationSettings="'wght' 400, 'opsz' 14" />

                <TextView
                    style="@style/WidgetText"
                    android:id="@+id/t1v"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="11sp"
                    android:fontVariationSettings="'wght' 400, 'opsz' 14" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/t2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/WidgetText"
                    android:id="@+id/t2n"
                    android:layout_width="0dp"
