<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows (Android 12+): the small widget at rest, with Blob from the launcher icon. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_preview_blob" />

    <TextView
        style="@style/WidgetText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_ask" />

    <TextView
        style="@style/WidgetText.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Wed 11 Nov" />
</LinearLayout>
